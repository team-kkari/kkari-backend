variable "project" {
  description = "Project/service name. Used as the name prefix and the required `project` tag."
  type        = string
  default     = "kkarimarket"

  validation {
    condition     = can(regex("^[a-z][a-z0-9]*$", var.project))
    error_message = "project must be lowercase alphanumeric and start with a letter."
  }
}

variable "owner" {
  description = "Required `owner` tag."
  type        = string
  default     = "whiyoung"
}

variable "region" {
  description = "AWS region for the demo customer infrastructure."
  type        = string
  default     = "ap-northeast-2"
}

variable "aws_profile" {
  description = "Local AWS CLI profile. Must be the personal (demo customer) profile."
  type        = string
  default     = "personal"

  validation {
    condition     = !contains(["default", "native"], var.aws_profile)
    error_message = "The default and native profiles are forbidden for this project."
  }
}

variable "allowed_account_id" {
  description = "The only AWS account Terraform may touch."
  type        = string
  default     = "511256179815"

  # Only the personal demo account is ever acceptable (see CLAUDE.md).
  validation {
    condition     = var.allowed_account_id == "511256179815"
    error_message = "allowed_account_id must be the personal demo account 511256179815."
  }
}

variable "availability_zone" {
  description = "Single AZ used for every resource. Single-AZ is intentional (the demo story is a single point of failure)."
  type        = string
  default     = "ap-northeast-2a"
}

variable "web_instance_type" {
  description = "Web server type. Keep a t3 type: credit_specification is set to standard to avoid surplus-credit charges."
  type        = string
  default     = "t3.small"
}

variable "batch_instance_type" {
  description = "Settlement batch server type. Intentionally oversized for the waste scenario."
  type        = string
  default     = "m7i-flex.large"
}

variable "dev_instance_type" {
  description = "Development server type. Keep a t3 type (see web_instance_type)."
  type        = string
  default     = "t3.micro"
}

variable "root_volume_size_gb" {
  description = "Root volume size for every EC2 instance (AL2023 AMI needs at least 8)."
  type        = number
  default     = 8

  validation {
    condition     = var.root_volume_size_gb >= 8
    error_message = "root_volume_size_gb must be at least 8."
  }
}

variable "orphan_volume_size_gb" {
  description = "Size of the intentionally unattached EBS volume."
  type        = number
  default     = 8
}

variable "db_instance_class" {
  description = "RDS instance class."
  type        = string
  default     = "db.t3.micro"
}

variable "db_engine_version" {
  description = "RDS PostgreSQL version (full version, verified orderable in ap-northeast-2)."
  type        = string
  default     = "16.15"
}

variable "db_allocated_storage_gb" {
  description = "RDS storage in GiB (gp3 for PostgreSQL needs at least 20)."
  type        = number
  default     = 20

  validation {
    condition     = var.db_allocated_storage_gb >= 20
    error_message = "db_allocated_storage_gb must be at least 20."
  }
}

variable "db_username" {
  description = "RDS master username. The password is generated by Terraform and kept only in the (git-ignored) state."
  type        = string
  default     = "kkariadmin"
}

variable "db_do_not_change" {
  description = "Adds the do-not-change=true tag to the DB (demo: customer marks it as a protected resource). Team decision pending."
  type        = bool
  default     = true
}

variable "batch_nightly_peak" {
  description = "If true, the batch server burns ~90% CPU for 20 minutes at 02:00 KST. Team decision pending."
  type        = bool
  default     = true
}
