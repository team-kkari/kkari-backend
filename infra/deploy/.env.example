# 서버의 ~/kkari/.env 로 복사해서 값을 채운다. 실제 값은 git에 올리지 않는다.
# 비밀값 생성 예: openssl rand -base64 48

# 배포 때 CD 워크플로가 채운다 (직접 지정하지 않아도 된다)
BACKEND_IMAGE=ghcr.io/team-kkari/kkari-backend:latest

DB_NAME=kkari
DB_USERNAME=kkari
DB_PASSWORD=

JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000

AI_SERVER_URL=http://ai:8000
AWS_REGION=ap-northeast-1

# AI 서버가 /v1/internal/** 를 부를 때 쓰는 토큰. 32자 이상 (openssl rand -base64 48)
INTERNAL_API_TOKEN=
# AWS Price List API 전용 별도 계정 키
PRICING_AWS_ACCESS_KEY_ID=
PRICING_AWS_SECRET_ACCESS_KEY=
JPA_DDL_AUTO=update
SWAGGER_ENABLED=true
