# 서버의 ~/kkari/.env 로 복사해서 값을 채운다. 실제 값은 git에 올리지 않는다.
# 비밀값 생성 예: openssl rand -base64 48

# 배포 때 CD 워크플로가 채운다 (직접 지정하지 않아도 된다)
BACKEND_IMAGE=ghcr.io/team-kkari/kkari-backend:latest

DB_NAME=kkari
DB_USERNAME=kkari
DB_PASSWORD=

JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000

AI_SERVER_URL=http://ai:8000
# ai 컨테이너 이미지. 기본값은 서버에서 직접 빌드한 kkari-ai:local. AI 레포 CD 가 생기면 GHCR 이미지로 바꾼다.
AI_IMAGE=kkari-ai:local
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AWS_REGION=ap-northeast-1
JPA_DDL_AUTO=update
SWAGGER_ENABLED=true
